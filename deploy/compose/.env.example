# agents-firewall control plane — copy to .env and replace every CHANGE_ME value.
# Generate secrets with: openssl rand -base64 32

# Public origin of the API as seen by browsers, the CLI and the Hermes plugin (behind your TLS proxy).
AFW_PUBLIC_URL=https://afw.example.com
# Extra DNS names / IPs written into the certificate of the gateway endpoint (:8443), comma separated.
AFW_PUBLIC_HOSTNAMES=afw.example.com
# Origin of the console (CORS).
AFW_CONSOLE_URL=https://afw.example.com

# PostgreSQL (configuration, audit, and logs unless ClickHouse is used).
AFW_POSTGRES_USER=afw
AFW_POSTGRES_PASSWORD=CHANGE_ME
AFW_POSTGRES_DB=afw

# Content encryption key (AES-256-GCM, 32 bytes base64) — back it up: without it stored bodies are lost.
AFW_DATA_KEY=CHANGE_ME

# First administrator token (use it once to create real tokens or configure OIDC, then remove it).
AFW_BOOTSTRAP_ADMIN_TOKEN=

# OIDC (optional, generic provider).
AFW_OIDC_ISSUER=
AFW_OIDC_CLIENT_ID=
AFW_OIDC_AUDIENCE=

# Log store: postgres (default) or clickhouse (start with --profile clickhouse).
AFW_LOG_STORE=postgres
AFW_CLICKHOUSE_URL=http://clickhouse:8123
AFW_CLICKHOUSE_USER=afw
AFW_CLICKHOUSE_PASSWORD=

# Published ports.
AFW_API_BIND=127.0.0.1
AFW_API_PORT=8080
AFW_GW_BIND=0.0.0.0
AFW_GW_PORT=8443
AFW_CONSOLE_BIND=127.0.0.1
AFW_CONSOLE_PORT=3000

# Images (built locally by default; nothing is published by this repository).
AFW_API_IMAGE=afw-api:local
AFW_CONSOLE_IMAGE=afw-console:local
AFW_LOG_LEVEL=info
