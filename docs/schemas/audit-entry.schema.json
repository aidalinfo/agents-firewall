{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditEntry",
  "description": "Hash-chained audit entry: `hash = sha256(prev_hash || canonical_json(entry without hash))`.",
  "type": "object",
  "required": [
    "action",
    "actor",
    "at",
    "hash",
    "interface",
    "prev_hash",
    "seq",
    "target"
  ],
  "properties": {
    "action": {
      "type": "string"
    },
    "actor": {
      "$ref": "#/definitions/Actor"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "diff": {
      "default": null
    },
    "hash": {
      "type": "string"
    },
    "interface": {
      "$ref": "#/definitions/Interface"
    },
    "prev_hash": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "format": "int64"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "target": {
      "type": "string"
    }
  },
  "definitions": {
    "Actor": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ActorKind"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "cli",
        "agent",
        "system"
      ]
    },
    "Interface": {
      "type": "string",
      "enum": [
        "ui",
        "cli",
        "mcp",
        "api",
        "system"
      ]
    }
  }
}
