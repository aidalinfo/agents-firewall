# agents-firewall gateway — copy to gateway.env.
# API gateway endpoint (mTLS, port 8443 of the control plane).
AFW_CONSOLE_URL=https://afw.example.com:8443
# Console CA certificate (console-ca.crt, from the API state volume) to trust the endpoint on first contact.
AFW_CONSOLE_CA_FILE=
# One-time token (15 min): `afw gateways token create` or Console > Gateways > Register.
AFW_REGISTRATION_TOKEN=CHANGE_ME
AFW_GATEWAY_NAME=agents-host-1
# Internal network of the agents (fixed subnet; the gateway takes AFW_GATEWAY_IP).
AFW_INTERNAL_NETWORK=afw-internal
AFW_INTERNAL_SUBNET=10.77.0.0/24
AFW_GATEWAY_IP=10.77.0.2
# Host directory where the public inspection CA certificate is exported (mounted by enrolled agents).
AFW_CA_PUBLIC_DIR=/etc/agents-firewall
# Upstream resolver and extra trusted upstream CAs (empty = system defaults).
AFW_UPSTREAM_DNS=
AFW_UPSTREAM_CA_FILE=
AFW_GATEWAY_IMAGE=afw-gateway:local
AFW_LOG_LEVEL=info
